{
  "name": "@carpool/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "types:generate": "openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts",
    "types:check": "openapi-typescript lib/api/openapi.json -o node_modules/.cache/schema.d.ts && diff -u lib/api/schema.d.ts node_modules/.cache/schema.d.ts",
    "check": "npm run format:check && npm run lint && npm run types:check && npm run typecheck && npm run test",
    "test": "vitest run",
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run maplibre:worker",
    "prebuild": "npm run maplibre:worker"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@tanstack/react-query": "5.103.1",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
