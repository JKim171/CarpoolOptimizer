# Copy to .env and fill in. .env is gitignored and must stay that way -- this repository is public
# and a committed credential is public permanently (CLAUDE.md).
#
# Placeholders only in this file. Never paste a real key here.

# Async SQLAlchemy URL. The value below matches the throwaway credentials in docker-compose.yml,
# which serve a container bound to localhost only. Production reads this from the instance
# environment, never from a file in the repository.
DATABASE_URL=postgresql+asyncpg://carpool:carpool@localhost:5432/carpool

# openrouteservice API key -- https://openrouteservice.org (docs/design.md 4.4). Used by the
# geocoding proxy; the matrix adapter joins it in Week 4. **The key never reaches the browser** --
# that is the whole reason geocoding is proxied rather than called from the page. Without it the
# geocoding endpoints answer 503 and the rest of the API works normally.
ORS_API_KEY=replace-me

# Provider base URL. api.openrouteservice.org is deprecated in favour of this one.
# ORS_BASE_URL=https://api.heigit.org

# How long a resolved coordinate stays in geocode_cache. It is a performance cache with a TTL,
# never a permanent store of provider output (docs/design.md 5.2); 30 days is the default.
# GEOCODE_TTL_SECONDS=2592000

# Restricts geocoding to one country -- the product is a US site (docs/design.md 2.4). Without it
# "Springfield" resolves somewhere plausible on the wrong continent. Set empty to disable.
# GEOCODE_COUNTRY=USA

# Geocoding sits in front of a coordinator typing, so a slow answer is worse than a failed one.
# ORS_TIMEOUT_SECONDS=6.0

# Browser origins allowed to call the API, as JSON. The web app is deployed separately, so every
# call from it is cross-origin. Omit this in development and it defaults to the `next dev` origin;
# production sets the real one from the instance environment.
# CORS_ALLOW_ORIGINS=["https://carpool.example"]

# development | production
ENVIRONMENT=development
