# Copy to .env and fill in. .env is gitignored and must stay that way -- this repository is public
# and a committed credential is public permanently (CLAUDE.md).
#
# Placeholders only in this file. Never paste a real key here.

# Async SQLAlchemy URL. The value below matches the throwaway credentials in docker-compose.yml,
# which serve a container bound to localhost only. Production reads this from the instance
# environment, never from a file in the repository.
DATABASE_URL=postgresql+asyncpg://carpool:carpool@localhost:5432/carpool

# openrouteservice API key -- https://openrouteservice.org, base URL api.heigit.org
# (docs/design.md 4.4). Unused until the routing adapter lands; the key never reaches the browser.
ORS_API_KEY=replace-me

# development | production
ENVIRONMENT=development
